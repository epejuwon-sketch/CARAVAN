# ==============================================================================
# CARAVAN Standalone Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and supply environment-specific credentials.
# NEVER commit raw production credentials, secret keys, or tokens to source control.

# Application Environment (development, staging, production)
CARAVAN_ENV=production
CARAVAN_APP_NAME="CARAVAN Funding Intelligence"
CARAVAN_PORT=8000
CARAVAN_HOST=0.0.0.0
CARAVAN_CORS_ORIGINS=["https://caravan-juwon2.vercel.app","https://caravan-platform.vercel.app","https://caravanfunding.com","http://localhost:5173","http://localhost:5174","http://localhost:3000"]

# Database Configuration (PostgreSQL / Supabase connection pooler)
# Format: postgresql://[user]:[password]@[host]:6543/[database]?sslmode=require
DATABASE_URL=sqlite:///./caravan.db

# Persistent Customer Document Storage (Supabase Storage / Private Vault)
# Set STORAGE_BACKEND to 'supabase' in production with valid credentials; 'auto' detects credentials.
STORAGE_BACKEND=auto
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=caravan-vault
DOCUMENT_MAX_SIZE_BYTES=15728640
SIGNED_URL_EXPIRY_SECONDS=900

# Security & Authentication (JWT Signing Key - min 32 chars)
JWT_SECRET_KEY=change-this-to-a-secure-random-32-character-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Scoped S2S Bridge for ULTRON Operations Interface
# Shared secret used by ULTRON private operations center to communicate with CARAVAN
ULTRON_BRIDGE_API_KEY=change-to-a-high-entropy-s2s-token-for-ultron-operations

# Scheduled Background Automation & Cron
CRON_SECRET=change-this-to-a-secure-random-cron-secret-in-production

# AI Intelligence Provider (Google Gemini + CARAVAN Fallback)
GEMINI_API_KEY=your_gemini_api_key_here
CARAVAN_AI_MODEL=gemini-2.5-flash
CARAVAN_AI_PROVIDER=gemini
CARAVAN_AI_FALLBACK_ENABLED=true

# Bot Protection & Anti-Abuse (Cloudflare Turnstile)
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Payment Gateways (Nigeria & International - Sandbox Mode)
# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key_here
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key_here
FLUTTERWAVE_WEBHOOK_HASH=your_flw_webhook_hash_here

# Paystack
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret_here

# Customer Communication & Support (Optional)
SUPPORT_EMAIL=support@caravanfunding.com
NOTIFICATIONS_ENABLED=true
